;startSize=10;endSize=10;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="esp_terapia" target="terapia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#444444;exitX=0;exitY=0.3;entryX=1;entryY=0.3;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="paciente_terapia" target="terapia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#444444;exitX=0.5;exitY=0;entryX=0.5;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="paciente_terapia" target="paciente"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legenda" value="&lt;b&gt;Modelo Lógico — GISA (PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; chave primária (sublinhada) · &lt;b&gt;FK&lt;/b&gt; chave estrangeira · &lt;b&gt;UQ&lt;/b&gt; único&lt;br&gt;Cardinalidade em notação pé-de-galinha: &lt;b&gt;||&lt;/b&gt; exatamente um · &lt;b&gt;o|&lt;/b&gt; zero ou um · &lt;b&gt;o&amp;lt;&lt;/b&gt; zero ou muitos.&lt;br&gt;&lt;br&gt;Herança por tabela: Paciente, Responsavel e Profissional usam o ID de Pessoa como PK e FK; Especialista e AssistenteSocial, o de Profissional; EspecialistaPJ, o de Especialista.&lt;br&gt;LogAuditoria guarda o CPF do usuário como texto (sem FK), para manter o registro mesmo se a pessoa for excluída.&lt;br&gt;Paciente_AssistenteSocial: no máximo um vínculo ativo (DataFim nula) por par." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="990" width="1040" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>