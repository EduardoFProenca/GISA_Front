<mxfile host="app.diagrams.net"><diagram id="arquitetura" name="Arquitetura em Camadas"><mxGraphModel dx="1500" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="view" value="Visão (View)&lt;br&gt;Front-end Angular (GISA_Front)" style="swimlane;html=1;whiteSpace=wrap;startSize=44;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;rounded=1;arcSize=2;swimlaneFillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="250" height="340" as="geometry"/></mxCell><mxCell id="telas" value="&lt;b&gt;Telas (componentes)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pacientes, Terapias, Profissionais,&lt;br&gt;Perfis, Auditoria, Início...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="210" height="60" as="geometry"/></mxCell><mxCell id="svcfront" value="&lt;b&gt;Services HTTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HttpClient → /api/...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="210" height="50" as="geometry"/></mxCell><mxCell id="authfront" value="&lt;b&gt;Auth Interceptor e Guards&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;envia o token JWT;&lt;br&gt;mostra só o que as permissões liberam&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="210" height="60" as="geometry"/></mxCell><mxCell id="externofront" value="&lt;b&gt;Recursos do front&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ViaCEP, tabelas CID-10 e CBO 2002&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="210" height="50" as="geometry"/></mxCell><mxCell id="api" value="API GISA — Spring Boot (Java 21)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="10" width="900" height="840" as="geometry"/></mxCell><mxCell id="apres" value="1. Camada de Apresentação — Controller (MVC: C)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;rounded=1;arcSize=2;swimlaneFillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="860" height="290" as="geometry"/></mxCell><mxCell id="jwt" value="&lt;b&gt;Filtro JWT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;JwtAuthenticationFilter&lt;br&gt;valida o token e o usuário&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="95" width="190" height="65" as="geometry"/></mxCell><mxCell id="security" value="&lt;b&gt;Spring Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SecurityConfig + @PreAuthorize&lt;br&gt;permissão por rota (403)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="95" width="190" height="65" as="geometry"/></mxCell><mxCell id="auditint" value="&lt;b&gt;Interceptor de Auditoria&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AuditoriaInterceptor&lt;br&gt;registra alterações e logins&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="95" width="190" height="65" as="geometry"/></mxCell><mxCell id="handler" value="&lt;b&gt;Tratamento de Erros&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RestExceptionHandler&lt;br&gt;erro em formato único (4xx/5xx)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="95" width="190" height="65" as="geometry"/></mxCell><mxCell id="dtos" value="&lt;b&gt;DTOs + Bean Validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RequestDTO / ResponseDTO por módulo&lt;br&gt;@Valid, @CpfValido, @SexoValido&lt;br&gt;o corpo nunca expõe as entidades&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="185" width="380" height="135" as="geometry"/></mxCell><mxCell id="controllers" value="&lt;b&gt;Controllers REST (@RestController)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Auth · Usuario · Perfil · Permissao · AcessoUsuario&lt;br&gt;Paciente · Responsavel · Escola · Cid&lt;br&gt;Profissional · Especialista · AssistenteSocial&lt;br&gt;Cargo · Cbo · Especialidade · Terapia · Auditoria&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="185" width="400" height="135" as="geometry"/></mxCell><mxCell id="negocio" value="2. Camada de Negócio — Services (MVC: M)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;rounded=1;arcSize=2;swimlaneFillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="440" y="360" width="860" height="230" as="geometry"/></mxCell><mxCell id="services" value="&lt;b&gt;Services de domínio (@Service)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PacienteService · ResponsavelService · EscolaService · CidService&lt;br&gt;ProfissionalService · EspecialistaService · EspecialistaPJService&lt;br&gt;AssistenteSocialService · JornadaTrabalhoService · CargoService · CboService&lt;br&gt;EspecialidadeService · TerapiaService (conflitos de horário, presença)&lt;br&gt;PerfilService · PermissaoService · UsuarioService · CadastroFacadeService&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="405" width="500" height="165" as="geometry"/></mxCell><mxCell id="transversais" value="&lt;b&gt;Serviços transversais&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AutenticacaoService · JwtService&lt;br&gt;PermissaoUsuarioLogado (escopo LGPD)&lt;br&gt;AuditoriaService · HistoricoPacienteService&lt;br&gt;EmailService (senha temporária, redefinição)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="405" width="300" height="165" as="geometry"/></mxCell><mxCell id="persist" value="3. Camada de Persistência — Repositories e Entidades (MVC: M)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;rounded=1;arcSize=2;swimlaneFillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="860" height="220" as="geometry"/></mxCell><mxCell id="repos" value="&lt;b&gt;Repositories (Spring Data JPA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PessoaRepository · PacienteRepository · TerapiaRepository&lt;br&gt;ProfissionalRepository · UsuarioRepository · PerfilRepository&lt;br&gt;LogAuditoriaRepository · EventoPacienteRepository ...&lt;br&gt;consultas com trava (agendamentos simultâneos)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="655" width="400" height="155" as="geometry"/></mxCell><mxCell id="entities" value="&lt;b&gt;Entidades JPA (@Entity) + Enums&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pessoa → Paciente, Responsavel, Profissional&lt;br&gt;Profissional → Especialista, EspecialistaPJ, AssistenteSocial&lt;br&gt;Terapia, Usuario, Perfil, Permissao, Cargo, Cbo, Escola...&lt;br&gt;StatusTerapia, StatusPresenca, StatusCadastro...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="655" width="380" height="155" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;esquema versionado pelo Flyway&lt;br&gt;(db/migration V1…)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="890" width="220" height="100" as="geometry"/></mxCell><mxCell id="email" value="&lt;b&gt;Serviço de E-mail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Brevo (API HTTPS) ou SMTP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;verticalAlign=middle;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="1370" y="455" width="170" height="70" as="geometry"/></mxCell><mxCell id="s0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="svcfront" target="jwt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="215"/><mxPoint x="330" y="127"/></Array></mxGeometry></mxCell><mxCell id="rotulo1" value="&lt;b&gt;1.&lt;/b&gt; requisição HTTP/JSON + token JWT&lt;br&gt;&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; resposta JSON" style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="336" y="140" width="80" height="80" as="geometry"/></mxCell><mxCell id="s1" value="2" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jwt" target="security"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="3. autorizado" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="security" target="controllers"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="após a resposta" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;endArrow=open;" edge="1" parent="1" source="controllers" target="auditint"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="exceções" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;endArrow=open;" edge="1" parent="1" source="controllers" target="handler"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5" value="valida" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=open;" edge="1" parent="1" source="dtos" target="controllers"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="4. DTO validado" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.33;exitY=1;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="controllers" target="services"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1012" y="350"/><mxPoint x="620" y="350"/></Array></mxGeometry></mxCell><mxCell id="s7" value="usa" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="services" target="transversais"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s8" value="5. regras de negócio" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.375;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="services" target="repos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s9" value="mapeia" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="repos" target="entities"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s10" value="6. SQL (JPA / Hibernate)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="repos" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s11" value="envia e-mail" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="transversais" target="email"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legenda" value="&lt;b&gt;Mapeamento MVC&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;View (V):&lt;/b&gt; front-end Angular, que consome a API.&lt;br&gt;&lt;b&gt;Controller (C):&lt;/b&gt; Controllers REST, que recebem a requisição, validam os DTOs e chamam os services.&lt;br&gt;&lt;b&gt;Model (M):&lt;/b&gt; Services (regras de negócio), Repositories e Entidades (dados).&lt;br&gt;&lt;br&gt;Cada camada só conversa com a camada logo abaixo; o fluxo numerado mostra o caminho de uma requisição." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="250" height="240" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>